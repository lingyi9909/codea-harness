{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FixPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixPlanId", "rootCause", "changes", "verification"],
  "properties": {
    "fixPlanId": {
      "type": "string",
      "minLength": 1
    },
    "rootCause": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "reason", "change"],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "change": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
