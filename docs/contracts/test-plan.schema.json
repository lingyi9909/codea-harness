{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntegrationTestPlan",
  "description": "集成测试计划，由 Integration Test Agent 设计，需经人工审批后才能用于生成测试代码",
  "type": "object",
  "additionalProperties": false,
  "required": ["planId", "targets"],
  "properties": {
    "planId": {
      "type": "string",
      "minLength": 1,
      "description": "测试计划唯一标识，用户必须通过该标识明确批准测试计划"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "description": "测试目标列表",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["controller", "endpoint", "scenarios"],
        "properties": {
          "controller": {
            "type": "string",
            "minLength": 1,
            "description": "Controller 类名"
          },
          "endpoint": {
            "type": "string",
            "minLength": 1,
            "description": "接口路径，如 POST /api/order/approve"
          },
          "serviceChain": {
            "type": "array",
            "description": "涉及的 Service 调用链",
            "items": { "type": "string" }
          },
          "repositoryChain": {
            "type": "array",
            "description": "涉及的 Repository 调用链",
            "items": { "type": "string" }
          },
          "externalMocks": {
            "type": "array",
            "description": "需要 Mock 的外部依赖",
            "items": { "type": "string" }
          },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "description": "测试场景列表",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "request", "expected"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "场景名称"
                },
                "preconditions": {
                  "type": "array",
                  "description": "前置条件",
                  "items": { "type": "string" }
                },
                "request": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["method", "path"],
                  "description": "HTTP 请求定义",
                  "properties": {
                    "method": {
                      "type": "string",
                      "minLength": 1,
                      "description": "HTTP 方法"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "description": "请求路径"
                    },
                    "headers": {
                      "type": "object",
                      "description": "请求头"
                    },
                    "body": {
                      "type": "object",
                      "description": "请求体"
                    }
                  }
                },
                "expected": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["httpStatus"],
                  "description": "预期结果",
                  "properties": {
                    "httpStatus": {
                      "type": "integer",
                      "description": "预期 HTTP 状态码"
                    },
                    "responseAssertions": {
                      "type": "array",
                      "description": "响应断言列表",
                      "items": { "type": "string" }
                    },
                    "databaseAssertions": {
                      "type": "array",
                      "description": "数据库断言列表",
                      "items": { "type": "string" }
                    },
                    "stateTransition": {
                      "type": "object",
                      "description": "状态流转",
                      "properties": {
                        "from": { "type": "string", "description": "变更前状态" },
                        "to": { "type": "string", "description": "变更后状态" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
