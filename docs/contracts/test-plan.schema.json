{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntegrationTestPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["planId", "targets"],
  "properties": {
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["controller", "endpoint", "scenarios"],
        "properties": {
          "controller": {
            "type": "string",
            "minLength": 1
          },
          "endpoint": {
            "type": "string",
            "minLength": 1
          },
          "serviceChain": {
            "type": "array",
            "items": { "type": "string" }
          },
          "repositoryChain": {
            "type": "array",
            "items": { "type": "string" }
          },
          "externalMocks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "request", "expected"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "preconditions": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "request": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["method", "path"],
                  "properties": {
                    "method": {
                      "type": "string",
                      "minLength": 1
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "headers": {
                      "type": "object"
                    },
                    "body": {
                      "type": "object"
                    }
                  }
                },
                "expected": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["httpStatus"],
                  "properties": {
                    "httpStatus": {
                      "type": "integer"
                    },
                    "responseAssertions": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "databaseAssertions": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "stateTransition": {
                      "type": "object",
                      "properties": {
                        "from": { "type": "string" },
                        "to": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
