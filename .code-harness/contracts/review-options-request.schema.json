{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewOptionsRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "changeAnalysisPath"],
  "properties": {
    "runId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "changeAnalysisPath": {"type": "string", "minLength": 1},
    "target": {"type": "string", "maxLength": 512}
  }
}
