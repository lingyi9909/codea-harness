{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanonicalReviewChangeSetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestedBaseRef",
    "resolvedBaseCommit",
    "mergeBase",
    "headCommit",
    "currentBranch",
    "includeWorkingTree",
    "files",
    "gitStateSha256",
    "snapshotSha256"
  ],
  "properties": {
    "requestedBaseRef": { "type": "string", "minLength": 1 },
    "resolvedBaseCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "mergeBase": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "headCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "currentBranch": { "type": "string", "minLength": 1 },
    "includeWorkingTree": { "type": "boolean" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "status", "sources", "hunks"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "status": { "enum": ["A", "M", "D"] },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["COMMITTED", "STAGED", "UNSTAGED", "UNTRACKED"] }
          },
          "hunks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["oldStart", "oldLines", "newStart", "newLines"],
              "properties": {
                "oldStart": { "type": "integer", "minimum": 0 },
                "oldLines": { "type": "integer", "minimum": 0 },
                "newStart": { "type": "integer", "minimum": 0 },
                "newLines": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "gitStateSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "snapshotSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
