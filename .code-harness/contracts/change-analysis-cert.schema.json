{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CertifiedChangeAnalysisCertificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "runtimeVersion",
    "analysisSha256",
    "changeSetSha256",
    "entrypointInventorySha256",
    "baseRef",
    "head",
    "resolvedBaseCommit",
    "mergeBase",
    "currentBranch",
    "includeWorkingTree",
    "snapshotSha256"
  ],
  "properties": {
    "runId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "runtimeVersion": { "type": "string", "minLength": 1 },
    "analysisSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "changeSetSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "entrypointInventorySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "baseRef": { "type": "string", "minLength": 1 },
    "head": { "type": "string", "minLength": 1 },
    "resolvedBaseCommit": { "type": "string", "minLength": 1 },
    "mergeBase": { "type": "string", "minLength": 1 },
    "currentBranch": { "type": "string", "minLength": 1 },
    "includeWorkingTree": { "type": "boolean" },
    "snapshotSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["FULL", "LIST", "TARGETED", "CHAIN_MAINTENANCE"] },
        "target": { "type": "string", "minLength": 1 }
      }
    }
  }
}
