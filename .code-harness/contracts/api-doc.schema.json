{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codea.local/contracts/api-doc.schema.json",
  "title": "Codea Harness API Documentation Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["controllers"],
  "properties": {
    "controllers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controller" }
    }
  },
  "$defs": {
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "apis"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "apis": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/api" } }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "httpMethod", "path", "description", "request", "response", "errorCodes", "businessNotes"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "httpMethod": { "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS", "HEAD"] },
        "path": { "type": "string", "minLength": 1, "pattern": "^/" },
        "description": { "type": "string" },
        "request": { "$ref": "#/$defs/request" },
        "response": { "$ref": "#/$defs/response" },
        "errorCodes": { "type": "array", "items": { "$ref": "#/$defs/error" } },
        "businessNotes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "example"],
      "properties": {
        "fields": { "type": "array", "items": { "$ref": "#/$defs/requestField" } },
        "example": {}
      }
    },
    "requestField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required", "description", "validation", "enumValues"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "validation": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "enumValues": { "type": "array", "items": { "$ref": "#/$defs/enumValue" } },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/requestField" } }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "example"],
      "properties": {
        "fields": { "type": "array", "items": { "$ref": "#/$defs/responseField" } },
        "example": {}
      }
    },
    "responseField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "description", "enumValues"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "enumValues": { "type": "array", "items": { "$ref": "#/$defs/enumValue" } },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/responseField" } }
      }
    },
    "enumValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "description"],
      "properties": {
        "value": { "type": ["string", "number"] },
        "description": { "type": "string" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "scenario"],
      "properties": {
        "code": { "type": ["string", "integer"], "minLength": 1 },
        "scenario": { "type": "string", "minLength": 1 }
      }
    }
  }
}
