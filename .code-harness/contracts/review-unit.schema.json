{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewUnitManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "harnessVersion", "mode", "changeSetSha256", "changeAnalysisSha256", "units", "sha256"],
  "properties": {
    "runId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "harnessVersion": {"type": "string", "minLength": 1},
    "mode": {"enum": ["FULL", "TARGETED"]},
    "changeSetSha256": {"$ref": "#/$defs/sha256"},
    "changeAnalysisSha256": {"$ref": "#/$defs/sha256"},
    "reviewScopeSha256": {"$ref": "#/$defs/sha256"},
    "units": {
      "type": "array",
      "items": {"$ref": "#/$defs/unit"}
    },
    "sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileRole": {
      "enum": ["Controller", "Service", "Repository", "Mapper", "MapperXml", "YamlConfig", "Test", "Entity", "DTO", "VO", "Validator", "ExceptionHandler", "Config", "Utility", "Other"]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "changed", "workspace"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "role": {"$ref": "#/$defs/fileRole"},
        "changed": {"type": "boolean"},
        "workspace": {"const": "current"}
      }
    },
    "hunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "newStart", "newLines"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "newStart": {"type": "integer", "minimum": 0},
        "newLines": {"type": "integer", "minimum": 0}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "files"],
      "properties": {
        "id": {"type": "string", "pattern": "^RU-(?:FILE-)?[0-9a-f]{64}$"},
        "entryPoint": {"type": "string", "minLength": 1},
        "chain": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "contextSymbols": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
        "changedHunks": {"type": "array", "items": {"$ref": "#/$defs/hunk"}}
      }
    }
  }
}
