{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FixPlan",
  "description": "修复方案。人工审批绑定 fixPlanId + unifiedDiff exact bytes + diffSha256 + files[].baseSha256；任何补丁变化都必须生成新的审批身份。",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixPlanId", "rootCause", "changes", "verification", "unifiedDiff", "diffSha256", "files"],
  "properties": {
    "fixPlanId": {"type":"string","minLength":1},
    "rootCause": {"type":"string","minLength":1},
    "changes": {
      "type":"array","minItems":1,
      "items": {
        "type":"object","additionalProperties":false,"required":["file","reason","change"],
        "properties": {
          "file":{"type":"string","minLength":1},
          "reason":{"type":"string","minLength":1},
          "change":{"type":"string","minLength":1}
        }
      }
    },
    "verification": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "unifiedDiff": {"type":"string","minLength":1,"description":"用户审批的 exact UTF-8 unified diff bytes"},
    "diffSha256": {"$ref":"#/$defs/sha256"},
    "files": {
      "type":"array","minItems":1,
      "items": {
        "type":"object","additionalProperties":false,"required":["path","baseSha256"],
        "properties": {
          "path":{"type":"string","minLength":1},
          "baseSha256":{"$ref":"#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
