{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "database-evidence.schema.json",
  "title": "Database Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["queryId","runId","purpose","schema","statementType","columns","rows","rowCount","truncated","durationMs"],
  "properties": {
    "queryId": {"type":"string","minLength":1,"pattern":"^[A-Za-z0-9._-]+$"},
    "runId": {"type":"string","minLength":1,"pattern":"^[A-Za-z0-9._-]+$"},
    "purpose": {"type":"string","minLength":1},
    "schema": {"type":"string","minLength":1},
    "statementType": {"const":"SELECT"},
    "columns": {"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "rows": {"type":"array","items":{"type":"object","additionalProperties":true}},
    "rowCount": {"type":"integer","minimum":0},
    "truncated": {"type":"boolean"},
    "durationMs": {"type":"integer","minimum":0}
  }
}
