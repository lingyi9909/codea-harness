{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChainValidationResult",
  "description": "Runtime validation result for a Codea Harness Business Chain.",
  "type": "object",
  "additionalProperties": false,
  "required": ["chainId", "status", "errors", "warnings"],
  "properties": {
    "chainId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "status": { "enum": ["VALID", "STALE", "INVALID"] },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
