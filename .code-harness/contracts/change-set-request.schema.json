{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangeSetRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "baseRef", "includeWorkingTree"],
  "properties": {
    "runId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "baseRef": {"type": "string", "minLength": 1, "maxLength": 512},
    "includeWorkingTree": {"type": "boolean"}
  }
}
