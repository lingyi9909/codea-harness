{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntegrationTestPlan",
  "description": "集成测试计划。REUSE_EXISTING 保持无写入；存在 EXTEND_EXISTING / CREATE_NEW 时，人工审批绑定 planId + unifiedDiff exact bytes + diffSha256 + files[].baseSha256。",
  "type": "object",
  "additionalProperties": false,
  "required": ["targets"],
  "properties": {
    "planId": {
      "type": "string",
      "minLength": 1,
      "description": "仅写测试代码的计划需要；用户必须精确批准该 planId。"
    },
    "unifiedDiff": {
      "type": "string",
      "minLength": 1,
      "description": "存在测试写入时，用户审批的 exact UTF-8 unified diff bytes。"
    },
    "diffSha256": { "$ref": "#/$defs/sha256" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "baseSha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "baseSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "description": "测试目标列表",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["controller", "endpoint", "strategy", "existingTests", "scenarios"],
        "properties": {
          "controller": { "type": "string", "minLength": 1 },
          "endpoint": { "type": "string", "minLength": 1 },
          "strategy": {
            "type": "string",
            "enum": ["REUSE_EXISTING", "EXTEND_EXISTING", "CREATE_NEW"]
          },
          "existingTests": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["className", "path"],
              "properties": {
                "className": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 }
              }
            }
          },
          "serviceChain": { "type": "array", "items": { "type": "string" } },
          "repositoryChain": { "type": "array", "items": { "type": "string" } },
          "externalMocks": { "type": "array", "items": { "type": "string" } },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "coverageStatus", "coveredBy"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "coverageStatus": { "type": "string", "enum": ["COVERED", "MISSING"] },
                "coveredBy": { "type": "array", "items": { "type": "string" } },
                "preconditions": { "type": "array", "items": { "type": "string" } },
                "request": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["method", "path"],
                  "properties": {
                    "method": { "type": "string", "minLength": 1 },
                    "path": { "type": "string", "minLength": 1 },
                    "headers": { "type": "object" },
                    "body": { "type": "object" }
                  }
                },
                "expected": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["httpStatus"],
                  "properties": {
                    "httpStatus": { "type": "integer" },
                    "responseAssertions": { "type": "array", "items": { "type": "string" } },
                    "databaseAssertions": { "type": "array", "items": { "type": "string" } },
                    "stateTransition": {
                      "type": "object",
                      "properties": {
                        "from": { "type": "string" },
                        "to": { "type": "string" }
                      }
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": { "properties": { "coverageStatus": { "const": "COVERED" } }, "required": ["coverageStatus"] },
                  "then": { "properties": { "coveredBy": { "minItems": 1 } } }
                },
                {
                  "if": { "properties": { "coverageStatus": { "const": "MISSING" } }, "required": ["coverageStatus"] },
                  "then": {
                    "required": ["request", "expected"],
                    "properties": { "coveredBy": { "maxItems": 0 } }
                  }
                }
              ]
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "strategy": { "const": "REUSE_EXISTING" } }, "required": ["strategy"] },
            "then": {
              "properties": {
                "existingTests": { "minItems": 1 },
                "scenarios": {
                  "items": {
                    "required": ["coverageStatus"],
                    "properties": { "coverageStatus": { "const": "COVERED" } }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "strategy": { "const": "EXTEND_EXISTING" } }, "required": ["strategy"] },
            "then": {
              "properties": {
                "existingTests": { "minItems": 1 },
                "scenarios": {
                  "contains": {
                    "required": ["coverageStatus"],
                    "properties": { "coverageStatus": { "const": "MISSING" } }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "strategy": { "const": "CREATE_NEW" } }, "required": ["strategy"] },
            "then": {
              "properties": {
                "existingTests": { "maxItems": 0 },
                "scenarios": {
                  "items": {
                    "required": ["coverageStatus"],
                    "properties": { "coverageStatus": { "const": "MISSING" } }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["targets"],
        "properties": {
          "targets": {
            "contains": {
              "required": ["strategy"],
              "properties": { "strategy": { "not": { "const": "REUSE_EXISTING" } } }
            }
          }
        }
      },
      "then": { "required": ["planId", "unifiedDiff", "diffSha256", "files"] }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
