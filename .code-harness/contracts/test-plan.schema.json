{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntegrationTestPlan",
  "description": "集成测试计划，由 Integration Test Agent 设计。仅当存在 EXTEND_EXISTING / CREATE_NEW 目标时需 planId 人工审批；全部 REUSE_EXISTING 时无 planId、无需审批。",
  "type": "object",
  "additionalProperties": false,
  "required": ["targets"],
  "properties": {
    "planId": {
      "type": "string",
      "minLength": 1,
      "description": "测试计划唯一标识。仅当存在 EXTEND_EXISTING / CREATE_NEW 目标时必填；全部 REUSE_EXISTING 时省略。"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "description": "测试目标列表",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["controller", "endpoint", "strategy", "existingTests", "scenarios"],
        "properties": {
          "controller": {
            "type": "string",
            "minLength": 1,
            "description": "Controller 类名"
          },
          "endpoint": {
            "type": "string",
            "minLength": 1,
            "description": "接口路径，如 POST /api/order/approve"
          },
          "strategy": {
            "type": "string",
            "enum": ["REUSE_EXISTING", "EXTEND_EXISTING", "CREATE_NEW"],
            "description": "测试策略：复用现有测试 / 扩展现有测试 / 新建测试类"
          },
          "existingTests": {
            "type": "array",
            "description": "可复用或可扩展的现有测试。REUSE_EXISTING / EXTEND_EXISTING 至少 1 个；CREATE_NEW 必须为空。",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["className", "path"],
              "properties": {
                "className": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 }
              }
            }
          },
          "serviceChain": {
            "type": "array",
            "description": "涉及的 Service 调用链",
            "items": { "type": "string" }
          },
          "repositoryChain": {
            "type": "array",
            "description": "涉及的 Repository 调用链",
            "items": { "type": "string" }
          },
          "externalMocks": {
            "type": "array",
            "description": "需要 Mock 的外部依赖",
            "items": { "type": "string" }
          },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "description": "测试场景列表，含覆盖状态（COVERED / MISSING）",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "coverageStatus", "coveredBy"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "场景名称"
                },
                "coverageStatus": {
                  "type": "string",
                  "enum": ["COVERED", "MISSING"],
                  "description": "该场景是否已被现有测试覆盖"
                },
                "coveredBy": {
                  "type": "array",
                  "description": "覆盖该场景的现有测试方法，如 OrderControllerIT.shouldApprovePendingOrder。COVERED 至少 1 个；MISSING 必须为空数组。",
                  "items": { "type": "string" }
                },
                "preconditions": {
                  "type": "array",
                  "description": "前置条件",
                  "items": { "type": "string" }
                },
                "request": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["method", "path"],
                  "description": "HTTP 请求定义（MISSING 场景必填，COVERED 场景可省略）",
                  "properties": {
                    "method": {
                      "type": "string",
                      "minLength": 1,
                      "description": "HTTP 方法"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "description": "请求路径"
                    },
                    "headers": {
                      "type": "object",
                      "description": "请求头"
                    },
                    "body": {
                      "type": "object",
                      "description": "请求体"
                    }
                  }
                },
                "expected": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["httpStatus"],
                  "description": "预期结果（MISSING 场景必填，COVERED 场景可省略）",
                  "properties": {
                    "httpStatus": {
                      "type": "integer",
                      "description": "预期 HTTP 状态码"
                    },
                    "responseAssertions": {
                      "type": "array",
                      "description": "响应断言列表",
                      "items": { "type": "string" }
                    },
                    "databaseAssertions": {
                      "type": "array",
                      "description": "数据库断言列表",
                      "items": { "type": "string" }
                    },
                    "stateTransition": {
                      "type": "object",
                      "description": "状态流转",
                      "properties": {
                        "from": { "type": "string", "description": "变更前状态" },
                        "to": { "type": "string", "description": "变更后状态" }
                      }
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": { "coverageStatus": { "const": "COVERED" } },
                    "required": ["coverageStatus"]
                  },
                  "then": {
                    "properties": { "coveredBy": { "minItems": 1 } }
                  }
                },
                {
                  "if": {
                    "properties": { "coverageStatus": { "const": "MISSING" } },
                    "required": ["coverageStatus"]
                  },
                  "then": {
                    "required": ["request", "expected"],
                    "properties": { "coveredBy": { "maxItems": 0 } }
                  }
                }
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "strategy": { "const": "REUSE_EXISTING" } },
              "required": ["strategy"]
            },
            "then": {
              "properties": {
                "existingTests": { "minItems": 1 },
                "scenarios": {
                  "items": {
                    "required": ["coverageStatus"],
                    "properties": { "coverageStatus": { "const": "COVERED" } }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": { "strategy": { "const": "EXTEND_EXISTING" } },
              "required": ["strategy"]
            },
            "then": {
              "properties": {
                "existingTests": { "minItems": 1 },
                "scenarios": {
                  "contains": {
                    "required": ["coverageStatus"],
                    "properties": { "coverageStatus": { "const": "MISSING" } }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": { "strategy": { "const": "CREATE_NEW" } },
              "required": ["strategy"]
            },
            "then": {
              "properties": {
                "existingTests": { "maxItems": 0 },
                "scenarios": {
                  "items": {
                    "required": ["coverageStatus"],
                    "properties": { "coverageStatus": { "const": "MISSING" } }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["targets"],
        "properties": {
          "targets": {
            "contains": {
              "required": ["strategy"],
              "properties": {
                "strategy": { "not": { "const": "REUSE_EXISTING" } }
              }
            }
          }
        }
      },
      "then": {
        "required": ["planId"]
      }
    }
  ]
}
