{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApplyResult",
  "description": "Controlled Runtime 对一次补丁应用生成的机器审计证据。正式成功状态为 APPLIED；失败时 Runtime 返回错误且不得留下 APPLIED evidence。",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "planType", "planId", "diffSha256", "status", "appliedAt", "files", "rollbackPerformed"],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "planType": { "enum": ["FIX", "TEST"] },
    "planId": { "type": "string", "minLength": 1 },
    "diffSha256": { "$ref": "#/$defs/sha256" },
    "status": { "enum": ["APPLIED"] },
    "appliedAt": { "type": "string", "minLength": 1, "description": "Runtime 成功完成文件事务的 UTC RFC3339 时间" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "beforeSha256", "afterSha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "beforeSha256": { "$ref": "#/$defs/sha256" },
          "afterSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "rollbackPerformed": { "type": "boolean" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
