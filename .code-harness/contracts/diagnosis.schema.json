{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagnosis",
  "description": "故障诊断结果，由 Runtime Debugger 在测试执行或服务调试后产出",
  "type": "object",
  "additionalProperties": false,
  "required": ["classification", "rootCause", "evidence", "nextAction"],
  "properties": {
    "classification": {
      "description": "故障分类",
      "enum": [
        "TEST_COMPILE_ERROR",
        "TEST_CODE_ERROR",
        "TEST_CONTEXT_ERROR",
        "TEST_DATA_OR_ENVIRONMENT_ERROR",
        "SERVICE_START_ERROR",
        "PRODUCTION_CODE_ERROR",
        "UNKNOWN"
      ]
    },
    "rootCause": {
      "type": "string",
      "minLength": 1,
      "description": "根因描述"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "description": "证据列表（日志行、堆栈、报告摘要）",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nextAction": {
      "description": "建议的下一步动作",
      "enum": [
        "REPAIR_TEST",
        "GENERATE_FIX_PLAN",
        "RETRY_TEST",
        "REPORT_ENVIRONMENT",
        "STOP_UNKNOWN",
        "RESTART_SERVICE",
        "WAIT_FOR_MANUAL_REQUEST",
        "MANUAL_TEST_REPAIR_REQUIRED"
      ]
    }
  }
}
