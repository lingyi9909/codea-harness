{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagnosis",
  "description": "故障诊断结果，由 Runtime Debugger 在测试执行或服务调试后产出",
  "type": "object",
  "additionalProperties": false,
  "required": ["classification", "rootCause", "evidence", "nextAction"],
  "properties": {
    "classification": {
      "description": "故障分类",
      "enum": [
        "TEST_COMPILE_ERROR",
        "TEST_CODE_ERROR",
        "TEST_CONTEXT_ERROR",
        "TEST_DATA_OR_ENVIRONMENT_ERROR",
        "SERVICE_START_ERROR",
        "PRODUCTION_CODE_ERROR",
        "UNKNOWN"
      ]
    },
    "rootCause": {
      "type": "string",
      "minLength": 1,
      "description": "根因描述"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "description": "证据列表（日志行、堆栈、报告摘要）",
      "items": {"type": "string", "minLength": 1}
    },
    "failedTests": {
      "type": "array",
      "description": "集成测试运行失败的测试类与方法，从 Surefire 报告结构化提取，不得从 evidence 自然语言猜测；服务调试模式下可省略",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["testClass"],
        "properties": {
          "testClass": {"type": "string", "minLength": 1},
          "testMethod": {"type": ["string", "null"]}
        }
      }
    },
    "suspectSymbols": {
      "type": "array",
      "description": "从失败证据中提取的项目内可疑符号",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "codeEvidence": {
      "type": "array",
      "description": "通过 Code Navigation 实际读取过的源代码证据",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "symbol", "lineStart", "lineEnd", "reason"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "symbol": {"type": "string", "minLength": 1},
          "lineStart": {"type": "integer", "minimum": 1},
          "lineEnd": {"type": "integer", "minimum": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "databaseEvidence": {
      "type": "array",
      "description": "本次 Diagnosis 使用的已落盘 Database Evidence queryId",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "externalDependencies": {
      "type": "array",
      "description": "诊断到达但不可进入其服务端实现的外部依赖边界",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "nextAction": {
      "description": "建议的下一步动作",
      "enum": [
        "REPAIR_TEST",
        "GENERATE_FIX_PLAN",
        "RETRY_TEST",
        "REPORT_ENVIRONMENT",
        "STOP_UNKNOWN",
        "RESTART_SERVICE",
        "WAIT_FOR_MANUAL_REQUEST",
        "MANUAL_TEST_REPAIR_REQUIRED"
      ]
    }
  }
}
