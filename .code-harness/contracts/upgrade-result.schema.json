{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpgradeResult",
  "description": "harness upgrade 的确定性原子升级结果",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "fromVersion", "toVersion", "rollbackPerformed", "errors"],
  "properties": {
    "status": { "enum": ["UPGRADED", "ALREADY_UP_TO_DATE", "MANUAL_ACTION_REQUIRED", "UPGRADE_FAILED"] },
    "fromVersion": { "type": "string", "minLength": 1 },
    "toVersion": { "type": "string", "minLength": 1 },
    "updatedFiles": { "type": "array", "items": { "type": "string" } },
    "removedFiles": { "type": "array", "items": { "type": "string" } },
    "preservedFiles": { "type": "array", "items": { "type": "string" }, "description": "project.md、runs/** 与未被 registered migration 修改的项目状态" },
    "rollbackPerformed": { "type": "boolean" },
    "errors": { "type": "array", "items": { "type": "string" } },
    "migrations": { "type": "array", "items": { "type": "string" }, "description": "本次实际执行的 registered Config Migration id" }
  }
}
