{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewOutput",
  "description": "Runtime-owned renderer transport。1.6 起 Reviewer 不得把 findings[] 作为正式 Finding authority；正式问题只能由 same-run Certified Findings 映射。固定用户文案默认中文；Java 类名、方法名、路径和技术名词保持源码原文。",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "中文评审摘要"
    },
    "findings": {
      "type": "array",
      "description": "仅供 Runtime renderer transport 使用，由 same-run Certified Findings 映射；Agent 不得直接提交为正式 Finding。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "severity", "problem", "evidence", "impact", "recommendation", "needsTest", "introducedByChange", "confidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"enum": ["PRODUCTION_CODE", "TEST_VALIDITY"]},
          "severity": {"enum": ["critical", "high", "medium", "low"]},
          "anchorKind": {"enum": ["LINE", "SYMBOL", "FILE", "CHANGESET"]},
          "file": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "symbol": {"type": "string", "minLength": 1},
          "problem": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "recommendation": {"type": "string", "minLength": 1},
          "needsTest": {"type": "boolean"},
          "introducedByChange": {"type": "boolean"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
