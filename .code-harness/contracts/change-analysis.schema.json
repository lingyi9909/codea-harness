{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangeAnalysis",
  "description": "当前完整 Review Change Set 的变更分析事实。FULL 直接以全部 changedFiles 做机器 Coverage；TARGETED 仍保留完整 Change Set，但通过独立 review-scope.schema.json 声明并验证 selectedCallChains/scopedFiles。workspace dependency 只允许作为 Navigation/Chain evidence，不属于 Change Set/Review/Write Scope。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewScope",
    "changedFiles",
    "affectedControllers",
    "callChains",
    "externalDependencies",
    "riskAreas",
    "reviewCoverage"
  ],
  "properties": {
    "reviewScope": {
      "type": "object",
      "additionalProperties": false,
      "description": "Change Set 基线范围标识。它不是 1.4 TARGETED 的 ReviewScopeSelection；TARGETED 的选择通过独立 review-scope.schema.json 表达。",
      "required": ["currentBranch", "baseRef", "baseCommit", "mergeBase", "headCommit", "includeWorkingTree"],
      "properties": {
        "currentBranch": { "type": "string", "description": "当前分支名，Detached HEAD 时为 DETACHED_HEAD" },
        "baseRef": { "type": "string", "minLength": 1, "description": "基线 ref，如 origin/master" },
        "baseCommit": { "type": "string", "description": "基线 ref 当前指向的 commit" },
        "mergeBase": { "type": "string", "description": "merge-base(baseRef, HEAD) 的 commit" },
        "headCommit": { "type": "string", "minLength": 1, "description": "HEAD 指向的 commit" },
        "includeWorkingTree": { "type": "boolean", "description": "是否纳入 staged、unstaged 和 untracked 本地变化" }
      }
    },
    "changedFiles": {
      "type": "array",
      "description": "完整 current project Change Set 变更文件列表。workspace dependency 永远不得进入 changedFiles。TARGETED 也不得从这里删除 scope 外 changed file。MapperXml/YamlConfig 一旦进入 FULL changedFiles 即进入机器 Coverage required set。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "sources"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "description": "current project repository-relative 文件路径" },
          "role": { "$ref": "#/$defs/fileRole" },
          "hunkSummary": { "type": "string", "description": "变更摘要" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "description": "该文件的变更来源（同一文件去重后可能来自多个来源）",
            "items": { "enum": ["COMMITTED", "STAGED", "UNSTAGED", "UNTRACKED"] }
          }
        }
      }
    },
    "affectedControllers": {
      "type": "array",
      "description": "受影响的 Controller 列表。Controller 未发生直接修改但被变更 Service 反向定位时也可出现。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["controller", "endpoints", "impactType", "sourceSymbols"],
        "properties": {
          "controller": { "type": "string", "minLength": 1 },
          "endpoints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "impactType": { "enum": ["DIRECT_CHANGE", "AFFECTED_BY_CALL_CHAIN"] },
          "sourceSymbols": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "callChains": {
      "type": "array",
      "description": "与本次 Change Set 直接相关、已经确定性识别的 confirmed 调用链。链可经过 VERIFIED workspace dependency；symbol 唯一时可继续使用旧格式，存在跨 module/workspace 同名歧义时由 entryPointRef/chainRefs 承载 workspace + exact path + symbol Authority。1.4 TARGETED 的 selectedCallChains 必须是这里的真实子集；candidate/unresolved 不得包装到本数组。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entryPoint", "chain"],
        "properties": {
          "entryPoint": { "type": "string", "minLength": 1 },
          "chain": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "entryPointRef": { "$ref": "#/$defs/symbolRef" },
          "chainRefs": {
            "type": "array",
            "items": { "$ref": "#/$defs/symbolRef" }
          }
        }
      }
    },
    "symbolLocations": {
      "type": "array",
      "uniqueItems": true,
      "description": "Code Navigation 已确定性解析的 symbol → workspace-relative exact path 证据。workspace 缺省解释为 current（兼容 1.5.1）；非 current workspace 只允许参与 Navigation/Call Chain/Chain Validation，不得扩大 Review/Write Scope。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "path", "role", "source"],
        "properties": {
          "workspace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "description": "workspace identity；省略时等价 current"
          },
          "symbol": { "type": "string", "minLength": 1 },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:[^./:][^/:]*|\\.[^./:][^/:]*)(?:/(?:[^./:][^/:]*|\\.[^./:][^/:]*))*$"
          },
          "role": { "$ref": "#/$defs/navigationRole" },
          "source": { "enum": ["FIND_SYMBOL", "FIND_REFERENCES", "FIND_IMPLEMENTATIONS", "WORKSPACE_INHERITANCE"] },
          "from": { "type": "string", "minLength": 1, "description": "可选：该定位由哪个已确认 symbol 导航得到，用于证明 target/call-chain 与额外上下文文件的直接关系。" }
        }
      }
    },
    "resourceRelations": {
      "type": "array",
      "uniqueItems": true,
      "description": "current project Mapper.xml/YML 与已确认 Java symbol 的证据关系。只用于 1.4 Resource Review；workspace dependency resource 不属于本数组。TARGETED Runtime 仅把 changed 且 relation 命中 selected target/call-chain 的资源纳入 scopedFiles。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "resource", "fromSymbol", "fromKind", "source", "evidence"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:[^./:][^/:]*|\\.[^./:][^/:]*)(?:/(?:[^./:][^/:]*|\\.[^./:][^/:]*))*$"
          },
          "role": { "enum": ["MapperXml", "YamlConfig"] },
          "resource": { "type": "string", "minLength": 1, "description": "资源内的 statement/key 标识，例如 OrderMapper.xml#updateStatus 或 order.timeout-ms" },
          "fromSymbol": { "type": "string", "minLength": 1, "description": "与资源存在确定性关系的 Java class/method symbol" },
          "fromKind": { "enum": ["CLASS", "METHOD"] },
          "source": { "enum": ["MAPPER_STATEMENT", "CONFIG_REFERENCE"] },
          "evidence": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "role": { "const": "MapperXml" } }, "required": ["role"] },
            "then": { "properties": { "source": { "const": "MAPPER_STATEMENT" } } }
          },
          {
            "if": { "properties": { "role": { "const": "YamlConfig" } }, "required": ["role"] },
            "then": { "properties": { "source": { "const": "CONFIG_REFERENCE" } } }
          }
        ]
      }
    },
    "externalDependencies": {
      "type": "array",
      "description": "已确认的外部边界（RPC/MQ/Cache/第三方 SDK 等），导航到这里允许停止。",
      "items": { "type": "string", "minLength": 1 }
    },
    "riskAreas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "risk"],
        "properties": {
          "method": { "type": "string", "minLength": 1 },
          "risk": {
            "type": "array",
            "items": { "enum": ["stateTransition", "transactional", "authorization", "tenancy", "idempotency", "exceptionHandling", "databaseWrite"] }
          }
        }
      }
    },
    "reviewCoverage": {
      "type": "object",
      "additionalProperties": false,
      "description": "current project 已读取文件与未解析符号的证据集合。workspace dependency 可作为导航上下文，但不得作为 reviewedFiles/Changed File。FULL 的 status 继续由全部 changedFiles 机器复算；TARGETED 的最终 COMPLETE 由独立 ReviewScopeSelection + scoped coverage Runtime gate 判定。",
      "required": ["status", "reviewedFiles", "unresolvedSymbols"],
      "properties": {
        "status": { "enum": ["COMPLETE", "PARTIAL"] },
        "reviewedFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "role", "reason"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "role": { "$ref": "#/$defs/fileRole" },
              "reason": { "enum": ["CHANGED", "CALL_CHAIN"] }
            }
          }
        },
        "unresolvedSymbols": {
          "type": "array",
          "description": "无法确定性解析的 symbol。review list 必须与 confirmed callChains 分开呈现。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "from", "reason"],
            "properties": {
              "symbol": { "type": "string", "minLength": 1 },
              "from": { "type": "string", "minLength": 1 },
              "reason": { "enum": ["SYMBOL_NOT_FOUND", "IMPLEMENTATION_NOT_FOUND", "REFERENCE_NOT_FOUND", "AMBIGUOUS_IMPLEMENTATION"] }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "symbolRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "symbol"],
      "properties": {
        "workspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "description": "workspace identity；省略时等价 current"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[^./:][^/:]*|\\.[^./:][^/:]*)(?:/(?:[^./:][^/:]*|\\.[^./:][^/:]*))*$"
        },
        "symbol": { "type": "string", "minLength": 1 }
      }
    },
    "navigationRole": {
      "enum": ["Controller", "Service", "Repository", "Mapper", "Entity", "DTO", "VO", "Validator", "ExceptionHandler", "Config", "Utility", "Other"]
    },
    "fileRole": {
      "enum": ["Controller", "Service", "Repository", "Mapper", "MapperXml", "YamlConfig", "Test", "Entity", "DTO", "VO", "Validator", "ExceptionHandler", "Config", "Utility", "Other"]
    }
  }
}
