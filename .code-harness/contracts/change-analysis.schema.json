{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangeAnalysis",
  "description": "变更分析结果，由 Reviewer 在评审前产出，是后续评审和测试计划的上游输入",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewScope",
    "changedFiles",
    "affectedControllers",
    "callChains",
    "externalDependencies",
    "riskAreas",
    "reviewCoverage"
  ],
  "properties": {
    "reviewScope": {
      "type": "object",
      "additionalProperties": false,
      "description": "本次 Review 的范围标识，Reviewer、Integration Test Agent、Orchestrator 共享同一 Scope",
      "required": ["currentBranch", "baseRef", "baseCommit", "mergeBase", "headCommit", "includeWorkingTree"],
      "properties": {
        "currentBranch": { "type": "string", "description": "当前分支名，Detached HEAD 时为 DETACHED_HEAD" },
        "baseRef": { "type": "string", "minLength": 1, "description": "评审基线 ref，如 origin/master" },
        "baseCommit": { "type": "string", "description": "基线 ref 当前指向的 commit" },
        "mergeBase": { "type": "string", "description": "merge-base(baseRef, HEAD) 的 commit" },
        "headCommit": { "type": "string", "description": "HEAD 指向的 commit" },
        "includeWorkingTree": { "type": "boolean", "description": "是否纳入 staged、unstaged、untracked 本地变化" }
      }
    },
    "changedFiles": {
      "type": "array",
      "description": "变更文件列表",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "sources"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "description": "文件路径" },
          "role": { "$ref": "#/$defs/fileRole" },
          "hunkSummary": { "type": "string", "description": "变更摘要" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "description": "该文件的变更来源（同一文件去重后可能来自多个来源）",
            "items": { "enum": ["COMMITTED", "STAGED", "UNSTAGED", "UNTRACKED"] }
          }
        }
      }
    },
    "affectedControllers": {
      "type": "array",
      "description": "受影响的 Controller 列表。Controller 未发生直接修改但被变更 Service 反向定位时也可出现。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["controller", "endpoints"],
        "properties": {
          "controller": { "type": "string", "minLength": 1 },
          "endpoints": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "callChains": {
      "type": "array",
      "description": "与本次变更直接相关的项目内部调用链，可从 Controller 或 changed Service/Repository 等符号开始。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entryPoint", "chain"],
        "properties": {
          "entryPoint": { "type": "string", "minLength": 1 },
          "chain": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "externalDependencies": {
      "type": "array",
      "description": "已确认的外部边界（RPC/MQ/Cache/第三方 SDK 等），导航到这里允许停止。",
      "items": { "type": "string", "minLength": 1 }
    },
    "riskAreas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "risk"],
        "properties": {
          "method": { "type": "string", "minLength": 1 },
          "risk": {
            "type": "array",
            "items": { "enum": ["stateTransition", "transactional", "authorization", "tenancy", "idempotency", "exceptionHandling", "databaseWrite"] }
          }
        }
      }
    },
    "reviewCoverage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Review 完整性证据。只有 COMPLETE 才允许进入 Review Findings / Integration Test Agent。",
      "required": ["status", "reviewedFiles", "unresolvedSymbols"],
      "properties": {
        "status": { "enum": ["COMPLETE", "PARTIAL"] },
        "reviewedFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "role", "reason"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "role": { "$ref": "#/$defs/fileRole" },
              "reason": { "enum": ["CHANGED", "CALL_CHAIN"] }
            }
          }
        },
        "unresolvedSymbols": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "from", "reason"],
            "properties": {
              "symbol": { "type": "string", "minLength": 1 },
              "from": { "type": "string", "minLength": 1 },
              "reason": { "enum": ["SYMBOL_NOT_FOUND", "IMPLEMENTATION_NOT_FOUND", "REFERENCE_NOT_FOUND", "AMBIGUOUS_IMPLEMENTATION"] }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "fileRole": {
      "enum": ["Controller", "Service", "Repository", "Mapper", "Entity", "DTO", "VO", "Validator", "ExceptionHandler", "Config", "Utility", "Other"]
    }
  }
}
