{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangeAnalysis",
  "description": "变更分析结果，由 Reviewer 在评审前产出，是后续评审和测试计划的上游输入",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewScope",
    "changedFiles",
    "affectedControllers",
    "callChains",
    "externalDependencies",
    "riskAreas"
  ],
  "properties": {
    "reviewScope": {
      "type": "object",
      "additionalProperties": false,
      "description": "本次 Review 的范围标识，Reviewer、Integration Test Agent、Orchestrator 共享同一 Scope",
      "required": [
        "currentBranch",
        "baseRef",
        "mergeBase",
        "headCommit",
        "includeWorkingTree"
      ],
      "properties": {
        "currentBranch": {
          "type": "string",
          "description": "当前分支名，Detached HEAD 时为 DETACHED_HEAD"
        },
        "baseRef": {
          "type": "string",
          "minLength": 1,
          "description": "评审基线 ref，如 origin/master"
        },
        "baseCommit": {
          "type": "string",
          "description": "基线 ref 当前指向的 commit"
        },
        "mergeBase": {
          "type": "string",
          "description": "merge-base(baseRef, HEAD) 的 commit"
        },
        "headCommit": {
          "type": "string",
          "description": "HEAD 指向的 commit"
        },
        "includeWorkingTree": {
          "type": "boolean",
          "description": "是否纳入 staged、unstaged、untracked 本地变化"
        }
      }
    },
    "changedFiles": {
      "type": "array",
      "description": "变更文件列表",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "文件路径"
          },
          "role": {
            "enum": [
              "Controller",
              "Service",
              "Repository",
              "Mapper",
              "Entity",
              "DTO",
              "VO",
              "Validator",
              "ExceptionHandler",
              "Config",
              "Utility",
              "Other"
            ],
            "description": "文件角色分类"
          },
          "hunkSummary": {
            "type": "string",
            "description": "变更摘要"
          }
        }
      }
    },
    "affectedControllers": {
      "type": "array",
      "description": "受影响的 Controller 列表",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["controller", "endpoints"],
        "properties": {
          "controller": {
            "type": "string",
            "minLength": 1,
            "description": "Controller 类名"
          },
          "endpoints": {
            "type": "array",
            "description": "受影响的接口",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "callChains": {
      "type": "array",
      "description": "调用链列表",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entryPoint", "chain"],
        "properties": {
          "entryPoint": {
            "type": "string",
            "minLength": 1,
            "description": "调用入口方法"
          },
          "chain": {
            "type": "array",
            "description": "调用链（Controller → Service → Repository）",
            "items": { "type": "string" }
          }
        }
      }
    },
    "externalDependencies": {
      "type": "array",
      "description": "涉及的外部依赖",
      "items": { "type": "string" }
    },
    "riskAreas": {
      "type": "array",
      "description": "风险区域列表",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "risk"],
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1,
            "description": "方法名"
          },
          "risk": {
            "type": "array",
            "description": "风险标签",
            "items": {
              "enum": [
                "stateTransition",
                "transactional",
                "authorization",
                "tenancy",
                "idempotency",
                "exceptionHandling",
                "databaseWrite"
              ]
            }
          }
        }
      }
    }
  }
}
