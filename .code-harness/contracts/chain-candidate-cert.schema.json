{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChainCandidateCertificate",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "kind", "chainId", "candidatePath", "candidateHash", "analysisHash"],
  "properties": {
    "runId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "kind": {"enum": ["DISCOVERED", "REFRESH", "EDIT"]},
    "chainId": {"type": "string", "minLength": 1, "maxLength": 128},
    "candidatePath": {"type": "string", "minLength": 1},
    "candidateHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "analysisHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
