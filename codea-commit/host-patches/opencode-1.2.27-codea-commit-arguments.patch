   export async function command(input: CommandInput) {
+    // Reject before registry/template resolution: argument expansion can execute shell blocks.
+    if (input.command === "codea-commit" && input.arguments.trim()) {
+      const error = new Command.ArgumentsError({ message: "当前版本仅支持 /codea-commit" })
